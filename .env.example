# Local dev: a plain file works, no Turso account needed.
# Production (Vercel): set to your Turso libsql:// URL, see README.
DATABASE_URL="file:./local.db"
DATABASE_AUTH_TOKEN=""

# Password required to access the app (it's a public URL, so keep this set).
APP_PASSWORD="change-me"

# Random secret used to sign the login session cookie. Generate with:
# openssl rand -hex 32
SESSION_SECRET="change-me-too"
