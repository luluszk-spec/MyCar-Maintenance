generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String?
  createdAt        DateTime          @default(now())
  vehicles         Vehicle[]
  maintenanceTypes MaintenanceType[]
}

// type: "CAR" | "MOTORCYCLE"
model Vehicle {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  type            String
  make            String?
  model           String?
  year            Int?
  grade           String?
  plateNumber     String?
  purchaseDate    DateTime?
  currentOdometer Int                 @default(0)
  photoUrl        String?
  createdAt       DateTime            @default(now())
  records         MaintenanceRecord[]

  @@index([userId])
}

model MaintenanceType {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  defaultIntervalKm     Int?
  defaultIntervalMonths Int?
  isCustom              Boolean             @default(false)
  isCheckOnly           Boolean             @default(false)
  createdAt             DateTime            @default(now())
  records               MaintenanceRecord[]

  @@index([userId])
}

model MaintenanceRecord {
  id                String           @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceTypeId String?
  maintenanceType   MaintenanceType? @relation(fields: [maintenanceTypeId], references: [id])
  customTitle       String?
  date              DateTime
  odometer          Int
  cost              Int?
  memo              String?
  createdAt         DateTime         @default(now())

  @@index([vehicleId])
}
